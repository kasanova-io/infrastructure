 pub struct SealedPaymentV1<'a> {
     pub sealed_hex: &'a [u8],
+    pub hex_encoded: bool,
+}
+
+impl<'a> SealedPaymentV1<'a> {
+    /// Native payment partitions store raw sealed bytes for both ordinary
+    /// pay/payment and tips. Only the tip wire carries ASCII hex text.
+    pub fn storage_bytes(&self) -> Option<std::borrow::Cow<'a, [u8]>> {
+        if !self.hex_encoded {
+            return Some(std::borrow::Cow::Borrowed(self.sealed_hex));
+        }
+        if self.sealed_hex.len() % 2 != 0 {
+            return None;
+        }
+        let mut decoded = vec![0; self.sealed_hex.len() / 2];
+        faster_hex::hex_decode(self.sealed_hex, &mut decoded).ok()?;
+        Some(std::borrow::Cow::Owned(decoded))
+    }
 }
 
