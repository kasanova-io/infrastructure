+/// Same watched-output and best-effort sender rules for standalone blocks and
+/// source-bound shared activity. Keep actual script versions and header context.
+pub fn funds_event(
+    tx: &RpcTransaction,
+    tx_id: [u8; 32],
+    header: &RpcHeader,
+    sender: impl FnOnce() -> Option<AddressPayload>,
+) -> Option<FundsPushEvent> {
+    if crate::watch_only_is_empty() { return None; }
+    let credited = tx.outputs.iter().filter_map(|output| {
+        AddressPayload::try_from(&output.script_public_key).ok()
+            .filter(crate::watch_only_contains).map(|address| (address, output.value))
+    }).collect::<Vec<_>>();
+    if credited.is_empty() { return None; }
+    Some(FundsPushEvent { credited, sender: sender(), tx_id,
+        timestamp: header.timestamp, daa_score: header.daa_score })
+}
+
+/// Recompute with the same SDK as native ingestion; verbose IDs are not proof.
+pub fn funds_transaction_id(tx: &RpcTransaction) -> anyhow::Result<[u8; 32]> {
+    Ok(kaspa_consensus_core::tx::Transaction::try_from(tx.clone())?.id().as_bytes())
+}
