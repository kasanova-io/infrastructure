+use axum::{
+    Json,
+    http::{HeaderName, HeaderValue},
+    response::{IntoResponse, Response},
+};
 use indexer_db::FromBytes;
+use serde::Serialize;
+
+const HAS_MORE_HEADER: HeaderName = HeaderName::from_static("x-kasia-has-more");
+const NEXT_CURSOR_HEADER: HeaderName = HeaderName::from_static("x-kasia-next-cursor");
+
+/// Return an exact page boundary without changing the legacy JSON list body.
+///
+/// Callers fetch one extra row. This function removes that lookahead row and
+/// exposes whether another request is required through response headers.
+pub(super) fn paginated_response<T: Serialize>(
+    mut rows: Vec<T>,
+    limit: usize,
+    cursor: impl for<'a> Fn(&'a T) -> &'a str,
+) -> Response {
+    let has_more = rows.len() > limit;
+    if has_more {
+        rows.truncate(limit);
+    }
+    let next_cursor = has_more
+        .then(|| rows.last().map(|row| cursor(row).to_owned()))
+        .flatten();
+
+    let mut response = Json(rows).into_response();
+    response.headers_mut().insert(
+        HAS_MORE_HEADER,
+        HeaderValue::from_static(if has_more { "true" } else { "false" }),
+    );
+    if let Some(next_cursor) = next_cursor {
+        response.headers_mut().insert(
+            NEXT_CURSOR_HEADER,
+            HeaderValue::from_str(&next_cursor).expect("encoded cursor is an HTTP header value"),
+        );
+    }
+    response
+}
 
