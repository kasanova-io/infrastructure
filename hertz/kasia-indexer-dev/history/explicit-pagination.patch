 #[tokio::test]
+async fn continuation_headers_are_exact_and_match_the_last_returned_row()
+-> anyhow::Result<()> {
+    let fixture = Fixture::new()?;
+    for route in ROUTES {
+        let first = fixture.read(route, 50, None, None).await;
+        assert_eq!(first.headers()["x-kasia-has-more"], "true", "{route}");
+        let next = first.headers()["x-kasia-next-cursor"]
+            .to_str()?
+            .to_owned();
+        let first_rows = rows(first).await?;
+        assert_eq!(first_rows.len(), 50, "{route}");
+        assert_eq!(first_rows.last().unwrap()["cursor"], next, "{route}");
+
+        let last = fixture.read(route, 50, Some(next), None).await;
+        assert_eq!(last.headers()["x-kasia-has-more"], "false", "{route}");
+        assert!(
+            last.headers().get("x-kasia-next-cursor").is_none(),
+            "{route}"
+        );
+        assert_eq!(rows(last).await?.len(), 12, "{route}");
+
+        let exact = fixture.read(route, 1, None, Some(102)).await;
+        assert_eq!(exact.headers()["x-kasia-has-more"], "false", "{route}");
+        assert!(
+            exact.headers().get("x-kasia-next-cursor").is_none(),
+            "{route}"
+        );
+        assert_eq!(rows(exact).await?.len(), 1, "{route}");
+    }
+    Ok(())
+}
