+#[cfg(test)]
+mod shared_shutdown_tests {
+    use super::*;
+
+    fn source() -> anyhow::Result<(DataSource, flume::Receiver<BlockNotification>, flume::Receiver<RealTimeVccNotification>)> {
+        let client = KaspaRpcClient::new(
+            kaspa_wrpc_client::WrpcEncoding::Borsh,
+            Some("ws://127.0.0.1:1"),
+            None,
+            Some(kaspa_wrpc_client::prelude::NetworkId::new(kaspa_wrpc_client::prelude::NetworkType::Mainnet)),
+            None,
+        )?;
+        let (blocks, block_rx) = flume::bounded(4);
+        let (vcc, vcc_rx) = flume::bounded(4);
+        let (_shutdown_tx, shutdown_rx) = tokio::sync::mpsc::channel(1);
+        let (sender, receiver) = workflow_core::channel::bounded(8);
+        Ok((DataSource::new(client, blocks, vcc, shutdown_rx, Arc::new(AtomicU64::new(0)), Channel { sender, receiver }), block_rx, vcc_rx))
+    }
+
+    #[tokio::test]
+    async fn shared_shutdown_does_not_wait_for_absent_chain_processors() -> anyhow::Result<()> {
+        let (mut source, blocks, vcc) = source()?;
+        drop(blocks);
+        drop(vcc);
+        tokio::time::timeout(std::time::Duration::from_secs(1), source.handle_shutdown_for_mode(true)).await??;
+        assert!(source.shutting_down);
+        Ok(())
+    }
+
+    #[tokio::test]
+    async fn standalone_shutdown_keeps_both_processor_signals() -> anyhow::Result<()> {
+        let (mut source, blocks, vcc) = source()?;
+        tokio::time::timeout(std::time::Duration::from_secs(1), source.handle_shutdown_for_mode(false)).await??;
+        assert!(matches!(blocks.try_recv()?, BlockNotification::Shutdown));
+        assert!(matches!(vcc.try_recv()?, RealTimeVccNotification::Shutdown));
+        Ok(())
+    }
+    #[tokio::test]
+    async fn shared_disconnect_handles_full_and_closed_scanner_channels_then_reconnects()
+    -> anyhow::Result<()> {
+        let (mut source, blocks, vcc) = source()?;
+        source.shared_ingestion = true;
+        source.connected = true;
+        for _ in 0..4 {
+            source.block_sender.send(BlockNotification::Disconnected)?;
+            source.vcc_sender.send(RealTimeVccNotification::Disconnected)?;
+        }
+        tokio::time::timeout(std::time::Duration::from_secs(1), source.handle_disconnect()).await??;
+        assert!(!source.connected);
+        assert_eq!(blocks.len(), 4);
+        assert_eq!(vcc.len(), 4);
+        drop(blocks);
+        drop(vcc);
+        source.handle_command(Command::Request(Request::RequestSender { daa_score: 42, tx_id: [7; 32] })).await?;
+        assert_eq!(source.requests_queue.len(), 1);
+        tokio::time::timeout(std::time::Duration::from_secs(1), source.handle_disconnect()).await??;
+        source.handle_connect_impl().await?;
+        assert!(source.connected);
+        assert!(source.requests_queue.is_empty());
+        assert!(matches!(source.command_rx.receiver.recv().await?, Command::Request(Request::RequestSender { daa_score: 42, tx_id }) if tx_id == [7; 32]));
+        tokio::time::timeout(std::time::Duration::from_secs(1), source.handle_shutdown()).await??;
+        assert!(!source.connected);
+        Ok(())
+    }
