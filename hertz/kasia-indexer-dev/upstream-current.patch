+fn exact_primary_recipient(
+    tokens: &[String],
+    primary_addresses: &HashMap<String, String>,
+) -> Option<String> {
+    let recipients = tokens
+        .iter()
+        .filter_map(|token| primary_addresses.get(token))
+        .collect::<HashSet<_>>();
+    (recipients.len() == 1)
+        .then(|| recipients.into_iter().next().cloned())
+        .flatten()
+}
