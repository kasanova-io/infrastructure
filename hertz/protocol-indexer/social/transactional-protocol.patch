+    pub fn verify_tip_transaction(&self, transaction: &Transaction) -> Option<VerifiedTip> {
+        if hex::decode(&transaction.transaction_id).ok()?.len()!=32 { return None; }
+        let bytes=hex::decode(transaction.payload.as_ref()?).ok()?;
+        let payload=std::str::from_utf8(&bytes).ok()?.strip_prefix("kchat:1:")?;
+        let tip=crate::tips::parse_tip_parts(&payload.split(':').collect::<Vec<_>>()).ok()?;
+        let sender=crate::tips::xonly_bytes(&tip.sender_pubkey)?;
+        let author=crate::tips::xonly_bytes(&tip.author_pubkey)?;
+        if sender==author || !self.verify_kaspa_signature(&tip.signing_string(),&tip.sender_signature,&tip.sender_pubkey) {return None;}
+        Some(VerifiedTip {transaction:transaction.clone(),tip})
+    }
+
+    pub fn verify_kaposts_transaction(&self, transaction: &Transaction) -> Option<VerifiedKaPosts> {
+        if hex::decode(&transaction.transaction_id).ok()?.len()!=32 { return None; }
+        let bytes=hex::decode(transaction.payload.as_ref()?).ok()?;
+        let raw=std::str::from_utf8(&bytes).ok()?;
+        let cleaned=raw.chars().filter(|c| !c.is_control() || matches!(*c,'\n'|'\r'|'\t')).collect::<String>();
+        let payload=cleaned.strip_prefix("kchat:1:")?;
+        let action=crate::kaposts::parse_parts(&payload.split(':').collect::<Vec<_>>()).ok()?;
+        if !action.storage_fields_are_decodable() { return None; }
+        let message=action.signing_string().ok()?;
+        let (signature,public_key)=action.signature_fields();
+        if !self.verify_kaspa_signature(&message,signature,public_key) { return None; }
+        Some(VerifiedKaPosts {transaction:transaction.clone(),action})
+    }
+
+    pub async fn apply_verified_poll_in(&self, connection: &mut sqlx::Transaction<'_, sqlx::Postgres>, verified: &VerifiedKaPosts) -> Result<()> {
+        let crate::kaposts::KaPostsAction::Poll(poll)=&verified.action else {return Err(anyhow::anyhow!("not a verified poll"));};
+        anyhow::ensure!(crate::kaposts_projection::valid_poll(poll,verified.transaction.block_time.unwrap_or(0)),"invalid poll structure/time");
+        let post=KPost {sender_pubkey:poll.sender_pubkey.clone(),sender_signature:poll.sender_signature.clone(),base64_encoded_message:poll.base64_encoded_question.clone(),mentioned_pubkeys:poll.mentioned_pubkeys.clone()};
+        self.save_k_post_to_database(&mut **connection,&verified.transaction,post).await?;
+        let id=hex::decode(&verified.transaction.transaction_id)?;
+        sqlx::query("UPDATE k_contents SET content_type='poll' WHERE transaction_id=$1").bind(&id).execute(&mut **connection).await?;
+        sqlx::query("INSERT INTO k_polls(post_id,options,closes_at,block_time) VALUES($1,$2,$3,$4) ON CONFLICT DO NOTHING")
+            .bind(id).bind(&poll.options_b64_csv).bind(poll.closes_at_ms).bind(verified.transaction.block_time.unwrap_or(0)).execute(&mut **connection).await?;
+        Ok(())
+    }
