-    /// Process K protocol transaction
+    /// Decode and verify with the original native parser and Kaspa SDK before
+    /// acquiring a write transaction. The envelope owns its exact input; callers
+    /// cannot substitute another payload/time/id after verification.
+    pub fn verify_transaction(&self, transaction: &Transaction) -> Option<VerifiedAction> {
+        let payload_bytes = hex::decode(transaction.payload.as_ref()?).ok()?;
+        let payload = std::str::from_utf8(&payload_bytes).ok()?;
+        // Retain the established K parser's control-character handling.
+        let cleaned = payload.chars()
+            .filter(|c| !c.is_control() || matches!(*c, '\n' | '\r' | '\t'))
+            .collect::<String>();
+        let protocol = if cleaned.starts_with("k:1:") { "k" }
+            else if cleaned.starts_with("kchat:1:") { "kchat" } else { return None; };
+        let action = self.parse_k_protocol_payload(&cleaned).ok()?;
+        // Signature validity cannot authorize malformed native storage fields.
+        // Match the original SQL helpers' hex decoding without inventing new
+        // target/key length restrictions. Storage outages remain real errors.
+        let hex_ok = |value: &str| hex::decode(value).is_ok();
+        if !hex_ok(&transaction.transaction_id) { return None; }
+        let storable = match &action {
+            KActionType::Post(v) => v.mentioned_pubkeys.iter().all(|v|hex_ok(v)),
+            KActionType::Reply(v) => hex_ok(&v.post_id) && v.mentioned_pubkeys.iter().all(|v|hex_ok(v)),
+            KActionType::Quote(v) => hex_ok(&v.content_id) && hex_ok(&v.mentioned_pubkey),
+            KActionType::Vote(v) => hex_ok(&v.post_id) && hex_ok(&v.mentioned_pubkey),
+            KActionType::Follow(v) => hex_ok(&v.followed_user_pubkey),
+            KActionType::Block(v) => hex_ok(&v.blocked_user_pubkey),
+            KActionType::Broadcast(_) => true,
+            KActionType::Unknown(_) => false,
+        };
+        if !storable { return None; }
+        let (message, signature, public_key) = match &action {
+            KActionType::Post(value) => (
+                format!("{}:{}", value.base64_encoded_message,
+                    serde_json::to_string(&value.mentioned_pubkeys).ok()?),
+                &value.sender_signature, &value.sender_pubkey),
+            KActionType::Reply(value) => (
+                format!("{}:{}:{}", value.post_id, value.base64_encoded_message,
+                    serde_json::to_string(&value.mentioned_pubkeys).ok()?),
+                &value.sender_signature, &value.sender_pubkey),
+            KActionType::Quote(value) => (
+                format!("{}:{}:{}", value.content_id, value.base64_encoded_message, value.mentioned_pubkey),
+                &value.sender_signature, &value.sender_pubkey),
+            KActionType::Broadcast(value) => (
+                format!("{}:{}:{}", value.base64_encoded_nickname,
+                    value.base64_encoded_profile_image.as_deref().unwrap_or(""), value.base64_encoded_message),
+                &value.sender_signature, &value.sender_pubkey),
+            KActionType::Vote(value) => (
+                format!("{}:{}:{}", value.post_id, value.vote, value.mentioned_pubkey),
+                &value.sender_signature, &value.sender_pubkey),
+            KActionType::Follow(value) => (
+                format!("{}:{}", value.following_action, value.followed_user_pubkey),
+                &value.sender_signature, &value.sender_pubkey),
+            KActionType::Block(value) => (
+                format!("{}:{}", value.blocking_action, value.blocked_user_pubkey),
+                &value.sender_signature, &value.sender_pubkey),
+            KActionType::Unknown(_) => return None,
+        };
+        if !self.verify_kaspa_signature(&message, signature, public_key) { return None; }
+        Some(VerifiedAction { transaction: transaction.clone(), protocol, action })
+    }
