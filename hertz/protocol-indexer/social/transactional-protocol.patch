+    /// Shared journal callers own this transaction, its revision fence and quiet
+    /// notification context. No helper checks out a second pool connection.
+    pub async fn apply_verified_in(
+        &self, connection: &mut sqlx::Transaction<'_, sqlx::Postgres>, verified: &VerifiedAction,
+    ) -> Result<()> {
+        let transaction = &verified.transaction;
+        match verified.action.clone() {
+            KActionType::Broadcast(value) => self.save_k_broadcast_to_database(connection, transaction, value).await?,
+            KActionType::Post(value) => self.save_k_post_to_database(connection, transaction, value).await?,
+            KActionType::Reply(value) => self.save_k_reply_to_database(connection, transaction, value).await?,
+            KActionType::Vote(value) => self.save_k_vote_to_database(connection, transaction, value).await?,
+            KActionType::Block(value) => self.process_k_block_in_database(connection, transaction, value).await?,
+            KActionType::Quote(value) => self.save_k_quote_to_database(connection, transaction, value).await?,
+            KActionType::Follow(value) => self.process_k_follow_in_database(connection, transaction, value).await?,
+            KActionType::Unknown(_) => unreachable!("opaque verified action excludes unknown kinds"),
+        }
+        Ok(())
+    }
