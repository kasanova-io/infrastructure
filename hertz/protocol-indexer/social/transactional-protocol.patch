+/// Produced only by native signature verification. No public mutable fields:
+/// a caller cannot swap its transaction after review or bypass verification.
+#[derive(Debug, Clone)]
+pub struct VerifiedAction {
+    transaction: Transaction,
+    protocol: &'static str,
+    action: KActionType,
+}
+
+impl VerifiedAction {
+    pub fn transaction(&self) -> &Transaction { &self.transaction }
+    pub fn protocol(&self) -> &'static str { self.protocol }
+    pub fn action(&self) -> &KActionType { &self.action }
+}
