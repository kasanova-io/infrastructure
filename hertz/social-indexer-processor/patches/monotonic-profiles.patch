+        sqlx::query("SELECT pg_advisory_xact_lock(hashtextextended(encode($1::bytea, 'hex'), 730411))")
+            .bind(&sender_pubkey_bytes)
+            .execute(&mut *transaction_scope).await?;
+
+        // Only strictly newer original chain time replaces an incumbent.
