FROM rust:1.88-alpine AS builder
RUN apk add --no-cache musl-dev pkgconfig openssl-dev patch
WORKDIR /app
COPY Cargo.toml ./
RUN sed -i '/members = \[/,/\]/c\members = ["K-webserver"]' Cargo.toml
COPY K-webserver/Cargo.toml ./K-webserver/
COPY K-webserver/src ./K-webserver/src
COPY historical-author-keys.patch /tmp/historical-author-keys.patch
RUN patch --batch --fuzz=0 -p1 < /tmp/historical-author-keys.patch
RUN cargo test --bin K-webserver historical_author_key_tests && cargo build --release --bin K-webserver
COPY exact-vote-details.patch /tmp/exact-vote-details.patch
RUN patch --batch --fuzz=0 -p1 < /tmp/exact-vote-details.patch
COPY content-search.patch /tmp/content-search.patch
RUN patch --batch --fuzz=0 -p1 < /tmp/content-search.patch
RUN cargo test --bin K-webserver && cargo build --release --bin K-webserver

FROM alpine:3.19
RUN apk add --no-cache ca-certificates libssl3 && adduser -D -s /bin/sh app
WORKDIR /app
COPY --from=builder /app/target/release/K-webserver /app/
USER app
EXPOSE 3001
LABEL io.kasanova.social.compatibility="historical-author-keys-v1-exact-vote-v1-content-search-v1" org.opencontainers.image.revision="917863f49623aa6802e5ad4c0e246581470d93cb"
ENTRYPOINT ["./K-webserver"]
