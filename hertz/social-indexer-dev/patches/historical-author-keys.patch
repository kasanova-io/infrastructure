+
+// Author keys are opaque protocol identities; validation must not rewrite parity.
+fn is_valid_author_key(key: &str) -> bool {
+    key.bytes().all(|byte| byte.is_ascii_hexdigit())
+        && (key.len() == 64
+            || (key.len() == 66 && (key.starts_with("02") || key.starts_with("03"))))
+}
+
+#[cfg(test)]
+mod historical_author_key_tests {
+    use super::is_valid_author_key;
+
+    #[test]
+    fn accepts_historical_and_both_compressed_forms_without_rewriting() {
+        let x = "330a856d1fbc1b6312141d4535af72c01f5bcefa3930e120069e8cde0c6742b9";
+        for key in [x.to_string(), x.to_uppercase(), format!("02{x}"), format!("03{x}")] {
+            assert!(is_valid_author_key(&key));
+        }
+    }
+
+    #[test]
+    fn rejects_malformed_author_keys() {
+        for key in [String::new(), "a".repeat(63), "a".repeat(65), "g".repeat(64),
+                    format!("04{}", "a".repeat(64)), format!("02{}", "g".repeat(64)),
+                    format!(" {}", "a".repeat(64)), "é".repeat(32)] {
+            assert!(!is_valid_author_key(&key), "accepted malformed key: {key}");
+        }
+    }
+}
