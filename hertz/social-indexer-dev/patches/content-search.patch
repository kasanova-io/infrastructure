+            .bind(id).bind(stamp).bind(key).bind(bytes).bind(kind).bind(parent).execute(pool).await.unwrap();
+    }
+    insert(&pool, 1, 100, &author, b"Kaspa 100%_ literal", "post", None).await;
+    insert(
+        &pool,
