+#[tokio::test]
+async fn production_search_database_contract() {
+    let url =
+        std::env::var("SOCIAL_SEARCH_TEST_DATABASE_URL").expect("isolated test database required");
+    let pool = PgPoolOptions::new()
+        .max_connections(1)
