+        "CREATE TEMP TABLE k_blocks (sender_pubkey bytea, blocked_user_pubkey bytea)",
+        "CREATE TEMP TABLE k_votes (post_id bytea, sender_pubkey bytea, vote text)",
+        "CREATE TEMP TABLE k_mentions (content_id bytea, content_type text, mentioned_pubkey bytea)",
+        "CREATE TEMP TABLE k_broadcasts (sender_pubkey bytea, base64_encoded_nickname text, base64_encoded_profile_image text)",
+    ] {
+        sqlx::query(sql).execute(&pool).await.unwrap();
