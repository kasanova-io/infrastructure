+// Bounded, literal text search. Never decode untrusted historical bytes to SQL
+// text until both the Base64 structure and PostgreSQL-compatible UTF-8 pass.
+pub fn validate(
+    query: &str,
+    requester: &str,
+    limit: u32,
+    before: Option<&str>,
+    after: Option<&str>,
+) -> Result<(), &'static str> {
+    let query = query.trim();
+    if !(2..=200).contains(&query.chars().count()) || query.contains('\0') {
+        return Err("Query must contain 2 to 200 characters.");
+    }
+    if requester.len() != 66
+        || !(requester.starts_with("02") || requester.starts_with("03"))
+        || !requester.bytes().all(|b| b.is_ascii_hexdigit())
+    {
+        return Err("A compressed requester public key is required.");
+    }
+    if !(1..=100).contains(&limit) {
+        return Err("Limit must be between 1 and 100.");
+    }
+    if before.is_some() && after.is_some() {
+        return Err("Use only one cursor direction.");
+    }
+    for cursor in [before, after].into_iter().flatten() {
+        let valid = cursor
+            .split_once('_')
+            .map(|(stamp, id)| {
+                !stamp.is_empty()
+                    && !id.is_empty()
+                    && stamp.bytes().all(|b| b.is_ascii_digit())
+                    && id.bytes().all(|b| b.is_ascii_digit())
+                    && stamp.parse::<i64>().is_ok_and(|n| n >= 0)
+                    && id.parse::<i64>().is_ok_and(|n| n > 0)
+            })
+            .unwrap_or(false);
+        if !valid {
+            return Err("Invalid search cursor.");
+        }
+    }
+    Ok(())
+}
+
+pub fn condition(parameter: usize) -> String {
+    // Base64 whitespace is allowed by PostgreSQL and the protocol decoder.
+    // The nested CASEs are intentional: SQL AND does not guarantee evaluation order.
+    // Hex UTF-8 alternatives: non-NUL ASCII; valid 2/3/4-byte sequences, excluding
+    // overlong encodings, surrogate codepoints, and values above U+10FFFF.
+    let encoded = "regexp_replace(c.base64_encoded_message, E'[\\n\\r\\t ]', '', 'g')";
+    let utf8 = "^(0[1-9a-f]|[1-7][0-9a-f]|(c[2-9a-f]|d[0-9a-f])[89ab][0-9a-f]|e0[ab][0-9a-f][89ab][0-9a-f]|e[1-9abcef]([89ab][0-9a-f]){2}|ed[89][0-9a-f][89ab][0-9a-f]|f0[9ab][0-9a-f]([89ab][0-9a-f]){2}|f[1-3]([89ab][0-9a-f]){3}|f48[0-9a-f]([89ab][0-9a-f]){2})*$";
+    format!(
+        " AND strpos(lower(CASE WHEN {encoded} ~ '^([A-Za-z0-9+/]{{4}})*([A-Za-z0-9+/]{{2}}==|[A-Za-z0-9+/]{{3}}=)?$' THEN CASE WHEN encode(decode({encoded}, 'base64'), 'hex') ~ '{utf8}' THEN convert_from(decode({encoded}, 'base64'), 'UTF8') END END), lower(${parameter})) > 0"
+    )
+}
