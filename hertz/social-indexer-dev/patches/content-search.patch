+#[cfg(test)]
+mod tests {
+    use super::*;
+    fn viewer() -> String {
+        format!("02{}", "a".repeat(64))
+    }
+    #[test]
+    fn bounds_and_unicode_are_validated() {
+        for q in ["Kaspa", "100%_", "日本", "🦊🌊", "a'b\\c"] {
+            assert!(validate(q, &viewer(), 10, None, None).is_ok());
+        }
+        assert!(validate(&"界".repeat(200), &viewer(), 100, None, None).is_ok());
+        for q in ["", " a ", "\0x", &"界".repeat(201)] {
+            assert!(validate(q, &viewer(), 10, None, None).is_err());
+        }
+        for limit in [0, 101, u32::MAX] {
+            assert!(validate("kaspa", &viewer(), limit, None, None).is_err());
+        }
+    }
+    #[test]
+    fn requester_and_cursors_fail_closed() {
+        for key in [
+            "a".repeat(64),
+            format!("04{}", "a".repeat(64)),
+            format!("02{}", "z".repeat(64)),
+        ] {
+            assert!(validate("kaspa", &key, 10, None, None).is_err());
+        }
+        for cursor in [
+            "",
+            "1",
+            "1_hex",
+            "1_0",
+            "-1_2",
+            "1_2_3",
+            "9223372036854775808_1",
+        ] {
+            assert!(validate("kaspa", &viewer(), 10, Some(cursor), None).is_err());
+        }
+        assert!(validate("kaspa", &viewer(), 10, Some("1791491000000_5"), None).is_ok());
+        assert!(validate("kaspa", &viewer(), 10, Some("1_2"), Some("2_3")).is_err());
+    }
+    #[test]
+    fn predicate_uses_bound_literal_substring() {
+        let sql = condition(4);
+        assert!(sql.contains("lower($4)"));
+        assert!(sql.contains("strpos("));
+        assert!(!sql.contains("ILIKE"));
+        assert!(sql.contains("CASE WHEN"));
+    }
+}
