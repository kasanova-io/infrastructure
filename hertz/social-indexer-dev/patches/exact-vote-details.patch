+    async fn get_vote_by_id(
+        &self,
+        vote_id: &str,
+        requester_pubkey: &str,
+    ) -> DatabaseResult<Option<KVoteRecord>> {
+        let vote_id_bytes = Self::decode_hex_to_bytes(vote_id)?;
+        let requester_bytes = Self::decode_hex_to_bytes(requester_pubkey)?;
+        let row = sqlx::query(
+            "SELECT id, transaction_id, block_time, sender_pubkey, sender_signature, post_id, vote \
+             FROM k_votes WHERE transaction_id = $1 AND sender_pubkey = $2 LIMIT 1",
+        )
+        .bind(vote_id_bytes)
+        .bind(requester_bytes)
+        .fetch_optional(&self.pool)
+        .await
+        .map_err(|error| DatabaseError::QueryError(error.to_string()))?;
+        Ok(row.map(|row| KVoteRecord {
+            id: row.get("id"),
+            transaction_id: Self::encode_bytes_to_hex(&row.get::<Vec<u8>, _>("transaction_id")),
+            block_time: row.get::<i64, _>("block_time") as u64,
+            sender_pubkey: Self::encode_bytes_to_hex(&row.get::<Vec<u8>, _>("sender_pubkey")),
+            sender_signature: Self::encode_bytes_to_hex(&row.get::<Vec<u8>, _>("sender_signature")),
+            post_id: Self::encode_bytes_to_hex(&row.get::<Vec<u8>, _>("post_id")),
+            vote: row.get("vote"),
+            mention_block_time: None,
+            voted_content: None,
+            user_nickname: None,
+            user_profile_image: None,
+        }))
     }
 
