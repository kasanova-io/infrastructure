+fn is_valid_vote_request(id: &str, requester: &str) -> bool {
+    id.len() == 64
+        && id.bytes().all(|byte| byte.is_ascii_hexdigit())
+        && requester.len() == 66
+        && is_valid_author_key(requester)
+}
