+    /// GET /get-vote-details?id={voteId}&requesterPubkey={requesterPubkey}
+    /// Confirm an exact requester-owned vote without relying on notifications.
+    pub async fn get_vote_details(
+        &self,
+        vote_id: &str,
+        requester_pubkey: &str,
+    ) -> Result<String, String> {
+        if !is_valid_vote_request(vote_id, requester_pubkey) {
+            return Err(self.create_error_response(
+                "Expected a 64-hex transaction ID and a compressed 66-hex requester key.",
+                "INVALID_VOTE_QUERY",
+            ));
+        }
+        match self.db.get_vote_by_id(vote_id, requester_pubkey).await {
+            Ok(Some(vote)) => Ok(serde_json::json!({"vote": {
+                "id": vote.transaction_id,
+                "userPublicKey": vote.sender_pubkey,
+                "parentPostId": vote.post_id,
+                "voteType": vote.vote,
+            }}).to_string()),
+            Ok(None) => Err(self.create_error_response("Vote not found", "NOT_FOUND")),
+            Err(error) => {
+                log_error!("Failed to read exact vote: {}", error);
+                Err(self.create_error_response("Internal server error", "DATABASE_ERROR"))
+            }
+        }
+    }
