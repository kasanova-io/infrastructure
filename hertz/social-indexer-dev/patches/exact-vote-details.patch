+#[cfg(test)]
+mod vote_query_tests {
+    use super::is_valid_vote_request;
+
+    #[test]
+    fn accepts_exact_transaction_and_both_compressed_requester_forms() {
+        for prefix in ["02", "03"] {
+            assert!(is_valid_vote_request(&"a".repeat(64), &format!("{prefix}{}", "b".repeat(64))));
+        }
+    }
+
+    #[test]
+    fn rejects_malformed_ids_and_requesters_without_rewriting_keys() {
+        let requester = format!("02{}", "b".repeat(64));
+        for id in [String::new(), "a".repeat(63), "a".repeat(65), "g".repeat(64), "é".repeat(32)] {
+            assert!(!is_valid_vote_request(&id, &requester));
+        }
+        for key in [String::new(), "b".repeat(64), format!("04{}", "b".repeat(64)), format!("02{}", "g".repeat(64))] {
+            assert!(!is_valid_vote_request(&"a".repeat(64), &key));
+        }
+    }
+}
