+async fn handle_get_vote_details(
+    ConnectInfo(addr): ConnectInfo<SocketAddr>,
+    State(app_state): State<Arc<AppState>>,
+    Query(params): Query<GetPostDetailsQuery>,
+) -> Result<Json<serde_json::Value>, (StatusCode, Json<ApiError>)> {
+    check_rate_limit(&app_state, addr).await?;
+    let (Some(vote_id), Some(requester)) = (params.id, params.requester_pubkey) else {
+        return Err((StatusCode::BAD_REQUEST, Json(ApiError {
+            error: "Missing required id or requesterPubkey".to_string(),
+            code: "MISSING_PARAMETER".to_string(),
+        })));
+    };
+    match app_state.api_handlers.get_vote_details(&vote_id, &requester).await {
+        Ok(response) => serde_json::from_str(&response).map(Json).map_err(|_| {
+            (StatusCode::INTERNAL_SERVER_ERROR, Json(ApiError {
+                error: "Internal server error".to_string(),
+                code: "SERIALIZATION_ERROR".to_string(),
+            }))
+        }),
+        Err(response) => {
+            let error = serde_json::from_str::<ApiError>(&response).unwrap_or(ApiError {
+                error: "Internal server error".to_string(),
+                code: "INTERNAL_ERROR".to_string(),
+            });
+            let status = match error.code.as_str() {
+                "INVALID_VOTE_QUERY" | "MISSING_PARAMETER" => StatusCode::BAD_REQUEST,
+                "NOT_FOUND" => StatusCode::NOT_FOUND,
+                _ => StatusCode::INTERNAL_SERVER_ERROR,
+            };
+            Err((status, Json(error)))
+        }
+    }
+}
