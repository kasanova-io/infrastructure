[Unit]
Description=Reconcile missing original Amplitude and Hertz PostHog events
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/home/ren/Kasanova/tools/posthog
ExecStart=/usr/bin/python3 /home/ren/Kasanova/tools/posthog/daily_refill.py --config /home/ren/Kasanova/secrets/posthog/daily-refill.json
Environment=PYTHONDONTWRITEBYTECODE=1
UMask=0077
TimeoutStartSec=6h
KillMode=control-group
Slice=kasanova-posthog.slice
CPUQuota=100%
MemoryMax=2G
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/ren/Kasanova/tools/posthog/operations /home/ren/Kasanova/secrets/posthog /var/lib/docker/volumes/kasanova_posthog_analytics-journal/_data
